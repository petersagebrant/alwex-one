NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Auth Admin key. Never prefix with NEXT_PUBLIC_.
# Local Docker: `npx supabase status` → service_role key.
# Hosted: Project Settings → API → service_role, then set it in Vercel env.
# Do not commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=

# Password recovery (Supabase Auth → URL Configuration):
# Redirect URLs must include:
#   http://localhost:3000/auth/callback
#   https://<your-domain>/auth/callback
# Site URL may stay as http://localhost:3000 — the app intercepts
# recovery codes that land on `/` and routes them to /auth/update-password.
#
# Hosted Auth (manual — not changed by this repo):
# In Supabase Dashboard → Authentication → Providers → Email,
# turn off public signups ("Allow new users to sign up") so only
# VD/administrator invitations create accounts.
